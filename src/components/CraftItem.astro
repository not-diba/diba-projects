---
import { Image } from "astro:assets";
const { title, img, url, video } = Astro.props;
function convertCraftName(name: String) {
  return "craft/" + name.toLocaleLowerCase().replace(/\s/g, "-");
}
---

<a
  class="craft-item flex flex-col w-full glass-card rounded-2xl p-3 cursor-pointer transition-all duration-400 ease-out group"
  href={url}
  data-video-card
>
  <div class="relative w-full aspect-video rounded-xl overflow-hidden">
    <Image
      src={img}
      alt={title}
      width={410}
      height={230}
      format="avif"
      quality={80}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover rounded-xl transition-all duration-500 group-hover:opacity-0 group-hover:scale-105"
    />

    <video
      class="absolute inset-0 w-full h-full object-cover rounded-xl transition-all duration-500 opacity-0 scale-105 group-hover:opacity-100 group-hover:scale-100"
      data-src={video}
      preload="none"
      playsinline
      loop
      muted
      disablepictureinpicture></video>

    <!-- Gradient overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-[#0a090f]/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-400 rounded-xl"
    >
    </div>
  </div>

  <div
    class="craft-label flex w-full items-center px-4 py-4 mt-3 glass rounded-xl justify-between transition-all duration-400"
  >
    <p
      class="text-[#efefe5] group-hover:text-red-400 text-base font-medium transition-colors duration-300"
    >
      {title}
    </p>
    <div
      class="craft-arrow text-[#a6a6a2] group-hover:text-red-400 transition-all duration-300"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
      </svg>
    </div>
  </div>
</a>

<script>
  // Video card lazy loading manager
  class VideoCardManager {
    constructor() {
      this.observer = null;
      this.init();
    }

    init() {
      // Clean up existing observer
      if (this.observer) {
        this.observer.disconnect();
      }

      // Create intersection observer
      this.observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const video = entry.target.querySelector(
              "video[data-src]",
            ) as HTMLVideoElement;
            if (!video) return;

            // Load video when card is near viewport
            if (entry.isIntersecting && !video.src) {
              video.src = video.dataset.src!;
              video.load();

              // Play on hover (works on desktop)
              const playHandler = () => {
                video.play().catch(() => {
                  // Ignore autoplay errors
                });
              };

              const pauseHandler = () => {
                video.pause();
                video.currentTime = 0;
              };

              entry.target.addEventListener("mouseenter", playHandler);
              entry.target.addEventListener("mouseleave", pauseHandler);

              // Store handlers for cleanup
              (entry.target as any).__videoHandlers = {
                play: playHandler,
                pause: pauseHandler,
              };
            }
          });
        },
        {
          rootMargin: "100px",
          threshold: 0.1,
        },
      );

      // Observe all video cards
      const videoCards = document.querySelectorAll("[data-video-card]");
      videoCards.forEach((card) => {
        this.observer!.observe(card);
      });
    }

    cleanup() {
      if (this.observer) {
        this.observer.disconnect();
      }

      // Remove event listeners
      const videoCards = document.querySelectorAll("[data-video-card]");
      videoCards.forEach((card) => {
        const handlers = (card as any).__videoHandlers;
        if (handlers) {
          card.removeEventListener("mouseenter", handlers.play);
          card.removeEventListener("mouseleave", handlers.pause);
        }
      });
    }
  }

  // Initialize manager
  let videoManager = null;

  function initVideoCards() {
    if (videoManager) {
      videoManager.cleanup();
    }
    videoManager = new VideoCardManager();
  }

  // Initialize on page load
  document.addEventListener("DOMContentLoaded", initVideoCards);

  // Re-initialize after View Transitions
  document.addEventListener("astro:page-load", initVideoCards);

  // Cleanup before page swap
  document.addEventListener("astro:before-swap", () => {
    if (videoManager) {
      videoManager.cleanup();
    }
  });
</script>

<style>
  .craft-item {
    will-change: transform, box-shadow;
    transform: translateY(0);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .craft-item:hover {
    transform: translateY(-6px);
    box-shadow:
      0 12px 40px rgba(0, 0, 0, 0.3),
      0 0 0 1px rgba(239, 68, 68, 0.15);
  }

  .craft-item:active {
    transform: translateY(-3px);
  }

  video {
    will-change: opacity, transform;
  }

  .craft-label {
    will-change: background-color;
  }

  .craft-item:hover .craft-label {
    background: rgba(239, 68, 68, 0.08);
    border-color: rgba(239, 68, 68, 0.15);
  }

  .craft-arrow {
    transform: translateX(0);
    transition: transform 0.3s ease;
  }

  .craft-item:hover .craft-arrow {
    transform: translateX(4px);
  }

  .duration-400 {
    transition-duration: 400ms;
  }
</style>
