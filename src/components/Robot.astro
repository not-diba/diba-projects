<link rel="preload" href="models/robot-low.glb" as="fetch" crossorigin />

<div
  id="canvas-container"
  class="w-full h-100 md:min-h-full lg:min-h-full flex items-center justify-center overflow-visible relative z-50"
>
  <!-- Ultra-lightweight preview image (1-5KB optimized) -->
  <img
    id="model-preview"
    src="/models/robot-preview.webp"
    alt="3D Model Preview"
    class="w-full h-full object-contain transition-opacity duration-300 self-center"
    style="opacity: 1;"
  />
</div>

<script>
  import * as THREE from "three";
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
  import { DRACOLoader } from "three/addons/loaders/DRACOLoader.js";

  const container = document.getElementById("canvas-container");
  const previewImg = document.getElementById("model-preview");

  let scene, camera, renderer;
  let mixer,
    animationActions = [];
  let isPlaying = true;
  let currentModel = null;
  const clock = new THREE.Clock();

  function initThreeJS() {
    scene = new THREE.Scene();
    scene.background = null;

    camera = new THREE.PerspectiveCamera(
      90,
      container.clientWidth / container.clientHeight,
      0.1,
      1000,
    );
    camera.position.set(0, 0.5, 2.5);

    renderer = new THREE.WebGLRenderer({
      antialias: false, // Disable for low-res, enable for high-res
      alpha: true,
      powerPreference: "high-performance",
    });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(1); // Low-res uses 1x, high-res uses 2x
    renderer.outputEncoding = THREE.sRGBEncoding;

    renderer.domElement.style.opacity = "0";
    renderer.domElement.style.transition = "opacity 300ms ease-in-out";
    container.appendChild(renderer.domElement);

    const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
    scene.add(ambientLight);
    const directionalLight = new THREE.DirectionalLight(0xffffff, 1);
    directionalLight.position.set(1, 1, 1);
    scene.add(directionalLight);
  }

  function setupModel(gltf, isLowRes = false) {
    const model = gltf.scene;

    if (currentModel) {
      scene.remove(currentModel);
      currentModel.traverse((child) => {
        if (child.geometry) child.geometry.dispose();
        if (child.material) {
          if (Array.isArray(child.material)) {
            child.material.forEach((mat) => mat.dispose());
          } else {
            child.material.dispose();
          }
        }
      });
    }

    scene.add(model);
    currentModel = model;

    const box = new THREE.Box3().setFromObject(model);
    const center = box.getCenter(new THREE.Vector3());
    model.position.x = -center.x;
    model.position.y = -center.y + 0.65;
    model.position.z = -center.z;

    const size = box.getSize(new THREE.Vector3());
    const maxDim = Math.max(size.x, size.y, size.z);
    if (maxDim < 1) {
      const scale = 1 / maxDim;
      model.scale.set(scale, scale, scale);
    }

    if (gltf.animations && gltf.animations.length) {
      if (mixer) mixer.stopAllAction();

      mixer = new THREE.AnimationMixer(model);
      animationActions = [];

      gltf.animations.forEach((clip) => {
        const action = mixer.clipAction(clip);
        action.play();
        animationActions.push(action);
      });
    }

    // Render and show
    renderer.render(scene, camera);

    // First model loaded - fade out preview image
    if (previewImg.style.opacity === "1") {
      setTimeout(() => {
        previewImg.style.opacity = "0";
        renderer.domElement.style.opacity = "1";

        setTimeout(() => {
          previewImg.style.display = "none";
        }, 300);
      }, 50);
    }

    // If this is high-res, improve quality
    if (!isLowRes) {
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.antialias = true;
    }
  }

  initThreeJS();

  const dracoLoader = new DRACOLoader();
  dracoLoader.setDecoderPath(
    "https://www.gstatic.com/draco/versioned/decoders/1.5.6/",
  );

  const loader = new GLTFLoader();
  loader.setDRACOLoader(dracoLoader);

  // Load low-res immediately (preloaded, should be instant)
  loader.load(
    "models/robot-low.glb",
    (gltf) => {
      setupModel(gltf, true);

      // Start loading high-res immediately (parallel, not blocking)
      loader.load(
        "models/robot.glb",
        (gltfHigh) => {
          setupModel(gltfHigh, false);
        },
        undefined,
        (error) => {
          console.error("Error loading high-res model", error);
        },
      );
    },
    undefined,
    (error) => {
      console.error("Error loading low-res model", error);
      // Fallback: load high-res directly
      loader.load("models/robot.glb", (gltf) => setupModel(gltf, false));
    },
  );

  container.addEventListener("click", function () {
    if (!mixer || animationActions.length === 0) return;

    if (isPlaying) {
      animationActions.forEach((action) => {
        action.paused = true;
      });
      isPlaying = false;
    } else {
      animationActions.forEach((action) => {
        action.paused = false;
      });
      isPlaying = true;
    }
  });

  window.addEventListener("resize", () => {
    if (!camera || !renderer) return;
    camera.aspect = container.clientWidth / container.clientHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(container.clientWidth, container.clientHeight);
  });

  function animate() {
    requestAnimationFrame(animate);

    if (mixer && isPlaying) {
      mixer.update(clock.getDelta());
    }

    renderer.render(scene, camera);
  }
  animate();

  document.addEventListener("astro:before-swap", () => {
    if (renderer) renderer.dispose();
    if (currentModel) {
      currentModel.traverse((child) => {
        if (child.geometry) child.geometry.dispose();
        if (child.material) {
          if (Array.isArray(child.material)) {
            child.material.forEach((mat) => mat.dispose());
          } else {
            child.material.dispose();
          }
        }
      });
    }
  });
</script>

<style>
  #canvas-container {
    position: relative;
    z-index: 50;
    cursor: pointer;
  }

  #canvas-container canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 51;
  }

  #model-preview {
    position: relative;
    z-index: 50;
  }
</style>
