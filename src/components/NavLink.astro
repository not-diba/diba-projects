---
const { label, route } = Astro.props;
const isActive = Astro.url.pathname === route;
---

<a
  href={route === "back" ? "/" : route}
  class={`nav-link magnetic px-10 py-4 text-center text-2xl items-center justify-center transition-all duration-300 relative
    ${isActive ? "text-[#efefe5]" : "text-[#a6a6a2] hover:text-[#efefe5]"}`}
  data-magnetic
  data-magnetic-strength="0.2"
  onclick={route === "back"
    ? `preventDefault(); if (history.length > 1) { history.back(); } else { location.href = '/'; }`
    : undefined}
>
  <span class="relative z-10">{label}</span>
</a>

<style>
  .nav-link {
    will-change: transform, color;
  }

  .nav-link:active {
    transform: scale(0.97);
  }
</style>
