---
// Command Palette - CMD+K quick navigation
import { getCollection } from "astro:content";

const writing = await getCollection("writing");
const crafts = await getCollection("crafts");

const articles = writing.map((article) => ({
  type: "article",
  title: article.data.title,
  url: `/writing/${article.id}`,
  icon: "article",
}));

const projects = crafts.map((craft) => ({
  type: "craft",
  title: craft.data.title,
  url: `/craft/${craft.id}`,
  icon: "craft",
}));

const pages = [
  { type: "page", title: "Home", url: "/", icon: "home" },
  { type: "page", title: "Writing", url: "/writing/", icon: "writing" },
  { type: "page", title: "Crafts", url: "/crafts/", icon: "crafts" },
];

const socials = [
  {
    type: "social",
    title: "GitHub",
    url: "https://github.com/not-diba",
    icon: "github",
    external: true,
  },
  {
    type: "social",
    title: "LinkedIn",
    url: "https://www.linkedin.com/in/madiba-elvis/",
    icon: "linkedin",
    external: true,
  },
  {
    type: "social",
    title: "Bluesky",
    url: "https://bsky.app/profile/not-diba.bsky.social",
    icon: "bluesky",
    external: true,
  },
  {
    type: "social",
    title: "Email",
    url: "mailto:madibaelvis@gmail.com",
    icon: "email",
    external: true,
  },
];

const allItems = [...pages, ...articles, ...projects, ...socials];
---

<div
  id="command-palette"
  class="command-palette"
  role="dialog"
  aria-modal="true"
  aria-label="Command palette"
>
  <div class="palette-backdrop"></div>
  <div class="palette-container">
    <!-- Search Input -->
    <div class="palette-search-wrapper">
      <svg
        class="search-icon"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
      <input
        type="text"
        id="palette-search"
        class="palette-search"
        placeholder="Search..."
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="palette-kbd">ESC</kbd>
    </div>

    <!-- Results List -->
    <div id="palette-results" class="palette-results"></div>

    <!-- Empty State -->
    <div class="palette-empty" id="palette-empty">
      <p>No results found</p>
    </div>
  </div>
</div>

<script define:vars={{ allItems }}>
  class CommandPalette {
    constructor() {
      this.palette = document.getElementById("command-palette");
      this.backdrop = this.palette?.querySelector(".palette-backdrop");
      this.searchInput = document.getElementById("palette-search");
      this.resultsContainer = document.getElementById("palette-results");
      this.emptyState = document.getElementById("palette-empty");

      this.items = allItems;
      this.filteredItems = [];
      this.selectedIndex = 0;
      this.isOpen = false;

      if (this.palette) {
        this.init();
      }
    }

    init() {
      document.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === "k") {
          e.preventDefault();
          this.toggle();
        }

        if (e.key === "Escape" && this.isOpen) {
          e.preventDefault();
          this.close();
        }

        if (this.isOpen) {
          if (e.key === "ArrowDown") {
            e.preventDefault();
            this.navigate(1);
          } else if (e.key === "ArrowUp") {
            e.preventDefault();
            this.navigate(-1);
          } else if (e.key === "Enter") {
            e.preventDefault();
            this.selectCurrent();
          }
        }
      });

      this.backdrop?.addEventListener("click", () => this.close());
      this.searchInput?.addEventListener("input", (e) =>
        this.search(e.target.value),
      );
    }

    toggle() {
      this.isOpen ? this.close() : this.open();
    }

    open() {
      this.isOpen = true;
      this.palette.classList.add("open");
      this.searchInput.value = "";
      this.search("");
      document.body.style.overflow = "hidden";
      setTimeout(() => this.searchInput.focus(), 50);
    }

    close() {
      this.isOpen = false;
      this.palette.classList.remove("open");
      document.body.style.overflow = "";
      this.selectedIndex = 0;
    }

    search(query) {
      const q = query.toLowerCase().trim();
      this.filteredItems = q
        ? this.items.filter((item) => item.title.toLowerCase().includes(q))
        : this.items;
      this.selectedIndex = 0;
      this.render();
    }

    navigate(direction) {
      const maxIndex = this.filteredItems.length - 1;
      this.selectedIndex = Math.max(
        0,
        Math.min(maxIndex, this.selectedIndex + direction),
      );
      this.updateSelection();
      const selected = this.resultsContainer.querySelector(".selected");
      selected?.scrollIntoView({ block: "nearest", behavior: "smooth" });
    }

    selectCurrent() {
      const item = this.filteredItems[this.selectedIndex];
      if (item) {
        item.external
          ? window.open(item.url, "_blank")
          : (window.location.href = item.url);
        this.close();
      }
    }

    updateSelection() {
      this.resultsContainer
        .querySelectorAll(".palette-item")
        .forEach((item, index) => {
          item.classList.toggle("selected", index === this.selectedIndex);
        });
    }

    getIcon(type) {
      const icons = {
        home: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>',
        writing:
          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19l7-7 3 3-7 7-3-3z"></path><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path></svg>',
        crafts:
          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>',
        article:
          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>',
        craft:
          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>',
        github:
          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>',
        linkedin:
          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>',
        bluesky:
          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C6.5 7 3 10 3 14c0 3 2 5 5 5 2 0 3.5-1 4-2 .5 1 2 2 4 2 3 0 5-2 5-5 0-4-3.5-7-9-12z"></path></svg>',
        email:
          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>',
      };
      return icons[type] || icons.article;
    }

    render() {
      if (!this.resultsContainer || !this.emptyState) return;

      if (this.filteredItems.length === 0) {
        this.resultsContainer.innerHTML = "";
        this.emptyState.style.display = "block";
        return;
      }

      this.emptyState.style.display = "none";

      const html = this.filteredItems
        .map(
          (item, index) => `
        <a href="${item.url}"
           class="palette-item ${index === this.selectedIndex ? "selected" : ""}"
           data-index="${index}"
           style="display: flex; flex-direction: row; align-items: center; gap: 12px;"
           ${item.external ? 'target="_blank" rel="noopener noreferrer"' : ""}>
          <div class="item-icon" style="display: inline-flex; flex-shrink: 0;">${this.getIcon(item.icon)}</div>
          <span class="item-title" style="flex: 1;">${item.title}</span>
          ${item.external ? '<svg class="external-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>' : ""}
        </a>
      `,
        )
        .join("");

      this.resultsContainer.innerHTML = html;

      this.resultsContainer
        .querySelectorAll(".palette-item")
        .forEach((item, index) => {
          item.addEventListener("click", (e) => {
            if (!item.hasAttribute("target")) {
              e.preventDefault();
              this.selectedIndex = index;
              this.selectCurrent();
            } else {
              this.close();
            }
          });
          item.addEventListener("mouseenter", () => {
            this.selectedIndex = index;
            this.updateSelection();
          });
        });
    }

    cleanup() {
      document.body.style.overflow = "";
    }
  }

  let palette = null;

  function initPalette() {
    if (palette) palette.cleanup();
    palette = new CommandPalette();
  }

  document.addEventListener("DOMContentLoaded", initPalette);
  document.addEventListener("astro:page-load", initPalette);
</script>

<style>
  .command-palette {
    position: fixed;
    inset: 0;
    z-index: 100000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 20vh;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
  }

  .command-palette.open {
    opacity: 1;
    visibility: visible;
  }

  .palette-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .palette-container {
    position: relative;
    width: 100%;
    max-width: 480px;
    margin: 0 1rem;
    background: rgba(10, 9, 15, 0.85);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    box-shadow:
      0 25px 60px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    overflow: hidden;
    transform: scale(0.95) translateY(-20px);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .command-palette.open .palette-container {
    transform: scale(1) translateY(0);
  }

  /* Search */
  .palette-search-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .search-icon {
    color: #ef4444;
    flex-shrink: 0;
  }

  .palette-search {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 1rem;
    color: #efefe5;
    font-family: inherit;
    caret-color: #ef4444;
  }

  .palette-search::placeholder {
    color: #666;
  }

  .palette-kbd {
    padding: 0.25rem 0.5rem;
    font-size: 0.65rem;
    font-family: inherit;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 5px;
    color: #666;
  }

  /* Results */
  .palette-results {
    max-height: 320px;
    overflow-y: auto;
    padding: 0.5rem;
  }

  .palette-item {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 0.875rem;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    text-decoration: none;
    color: #a6a6a2;
    transition: all 0.15s ease;
  }

  .palette-item:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #efefe5;
  }

  .palette-item.selected {
    background: rgba(239, 68, 68, 0.12);
    color: #efefe5;
  }

  .item-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    min-width: 32px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    color: inherit;
    flex-shrink: 0;
    transition: all 0.15s ease;
  }

  .palette-item.selected .item-icon {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
  }

  .item-title {
    flex: 1;
    font-size: 0.9rem;
    font-weight: 500;
    display: inline;
  }

  .palette-item.selected .item-title {
    color: #ef4444;
  }

  .external-icon {
    color: #555;
    opacity: 0.6;
  }

  .palette-item.selected .external-icon {
    color: #ef4444;
    opacity: 1;
  }

  .palette-empty {
    display: none;
    padding: 2.5rem 1rem;
    text-align: center;
    color: #555;
    font-size: 0.9rem;
  }

  /* Scrollbar */
  .palette-results::-webkit-scrollbar {
    width: 4px;
  }

  .palette-results::-webkit-scrollbar-track {
    background: transparent;
  }

  .palette-results::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
  }

  @media (max-width: 640px) {
    .command-palette {
      padding-top: 10vh;
    }
  }
</style>
