---
import MobileNavItem from "./MobileNavItem.astro";
import NavIcon from "./NavIcon.astro";
import NavLink from "./NavLink.astro";
import Tooltip from "./Tooltip.astro";
import { Icon } from "astro-icon/components";

const { goBack } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!-- Desktop Navigation -->
<nav
  id="default-nav"
  class="hidden lg:flex fixed bottom-0 w-fit h-fit z-1000 self-center mb-8 gap-2 items-center nav-seesaw"
  role="navigation"
  aria-label="Main navigation"
>
  {
    goBack ? (
      <div class="glass-nav rounded-full p-1.5">
        <Tooltip text="Go back" id="back">
          <NavLink label="Back" route="back" />
        </Tooltip>
      </div>
    ) : (
      <>
        {/* Items before active */}
        {currentPath !== "/" && (
          <div class="glass-nav rounded-full p-3 flex gap-x-2 items-center">
            <Tooltip text="Kejani 🏠" id="home">
              <NavLink label="Home" route="/" />
            </Tooltip>
            {currentPath === "/crafts/" && (
              <Tooltip text="My articles 📚" id="writing">
                <NavLink label="Writing" route="/writing/" />
              </Tooltip>
            )}
          </div>
        )}

        {/* Active item - floating bubble */}
        <div class="active-nav-bubble">
          {currentPath === "/" && (
            <Tooltip text="Kejani 🏠" id="home">
              <NavLink label="Home" route="/" />
            </Tooltip>
          )}
          {currentPath === "/writing/" && (
            <Tooltip text="My articles 📚" id="writing">
              <NavLink label="Writing" route="/writing/" />
            </Tooltip>
          )}
          {currentPath === "/crafts/" && (
            <Tooltip text="My projects 💻" id="crafts">
              <NavLink label="Crafts" route="/crafts/" />
            </Tooltip>
          )}
        </div>

        {/* Items after active + social links */}
        <div class="glass-nav rounded-full p-3 flex gap-x-3 items-center">
          {currentPath === "/" && (
            <>
              <Tooltip text="My articles 📚" id="writing">
                <NavLink label="Writing" route="/writing/" />
              </Tooltip>
              <Tooltip text="My projects 💻" id="crafts">
                <NavLink label="Crafts" route="/crafts/" />
              </Tooltip>
            </>
          )}
          {currentPath === "/writing/" && (
            <Tooltip text="My projects 💻" id="crafts">
              <NavLink label="Crafts" route="/crafts/" />
            </Tooltip>
          )}

          <div class="h-10 w-px bg-white/10 mx-3" aria-hidden="true" />

          <a
            href="https://bsky.app/profile/not-diba.bsky.social"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit my Bluesky profile"
          >
            <Tooltip text="Bluesky" id="bluesky">
              <NavIcon icon="bluesky_social_line" hoverIcon="bluesky_social_fill" />
            </Tooltip>
          </a>

          <a
            href="https://www.linkedin.com/in/madiba-elvis/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit my LinkedIn profile"
          >
            <Tooltip text="I sometimes post my articles here as well" id="linkedIn">
              <NavIcon icon="linkedin_line" hoverIcon="linkedin_fill" />
            </Tooltip>
          </a>

          <a
            href="mailto:madibaelvis@gmail.com"
            aria-label="Send me an email"
          >
            <Tooltip text="Send me an email" id="mail">
              <NavIcon icon="mail_line" hoverIcon="mail_fill" />
            </Tooltip>
          </a>

          <div class="h-10 w-px bg-white/10" aria-hidden="true" />

          <a
            href="https://github.com/not-diba"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit my GitHub profile"
          >
            <Tooltip text="Most of my projects are hosted here" id="github">
              <NavIcon icon="github_line" hoverIcon="github_fill" />
            </Tooltip>
          </a>
        </div>
      </>
    )
  }
</nav>

<style>
  .active-nav-bubble {
    background: linear-gradient(
      135deg,
      rgba(239, 68, 68, 0.15) 0%,
      rgba(239, 68, 68, 0.08) 50%,
      rgba(255, 255, 255, 0.03) 100%
    );
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 50px;
    padding: 0.75rem 0.75rem;
    box-shadow:
      0 0 0 1px rgba(239, 68, 68, 0.25),
      0 4px 24px rgba(239, 68, 68, 0.15),
      0 8px 32px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
    transition: all 0.3s ease;
  }

  .active-nav-bubble:hover {
    transform: translateY(-4px);
    box-shadow:
      0 0 0 1px rgba(239, 68, 68, 0.35),
      0 6px 28px rgba(239, 68, 68, 0.2),
      0 12px 40px rgba(0, 0, 0, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
  }
</style>

<!-- Mobile Navigation -->
<div
  id="mobile-nav"
  class="lg:hidden w-4/5 h-fit fixed bottom-0 z-1000 mb-8 text-xl self-center"
  role="navigation"
  aria-label="Mobile navigation"
>
  <nav class="mobile-nav-glass rounded-full flex w-full">
    <div class="w-full mobile-nav-inner m-1.5 rounded-full flex items-center justify-center py-2">
      {
        goBack ? (
          <button
            onclick="history.back()"
            class="cursor-pointer"
            aria-label="Go back to previous page"
          >
            <NavLink label="Back" route="#" />
          </button>
        ) : (
          <>
            <button
              id="navToggle"
              class="cursor-pointer"
              aria-label="Open navigation menu"
              aria-expanded="false"
              aria-controls="bottomSheet"
            >
              {currentPath === "/" && <NavLink label="Home" route="#" />}
              {currentPath === "/writing/" && <NavLink label="Writing" route="#" />}
              {currentPath === "/crafts/" && <NavLink label="Crafts" route="#" />}
            </button>

            <!-- Bottom Sheet -->
            <div
              id="bottomSheet"
              role="dialog"
              aria-modal="true"
              aria-label="Navigation menu"
              class="bottom-sheet-glass fixed inset-x-0 bottom-0 z-3000 transition-transform duration-300 ease-in-out rounded-t-3xl min-h-[56vh] max-h-[100vh] overflow-y-auto"
              style="transform: translateY(calc(100% + 20px));"
            >
              <div class="p-5 pt-6">
                <div class="flex flex-col gap-4">
                  <!-- Main Navigation Links -->
                  <nav
                    class="glass rounded-2xl p-3 flex flex-col gap-3"
                    aria-label="Main pages"
                  >
                    <MobileNavItem label="Home" route="/" icon="home_4_line" />
                    <MobileNavItem label="Writing" route="/writing/" icon="paper_line" />
                    <MobileNavItem label="Crafts" route="/crafts/" icon="tool_line" />
                  </nav>

                  <!-- Social Links -->
                  <div class="flex gap-3 w-full" role="group" aria-label="Social media links">
                    <a
                      class="w-full"
                      href="https://github.com/not-diba"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="GitHub"
                    >
                      <NavIcon icon="github_line" hoverIcon="github_fill" />
                    </a>

                    <a
                      class="w-full"
                      href="https://www.linkedin.com/in/madiba-elvis/"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="LinkedIn"
                    >
                      <NavIcon icon="linkedin_line" hoverIcon="linkedin_fill" />
                    </a>

                    <a
                      class="w-full"
                      href="https://bsky.app/profile/not-diba.bsky.social"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="Bluesky"
                    >
                      <NavIcon icon="bluesky_social_line" hoverIcon="bluesky_social_fill" />
                    </a>
                  </div>

                  <div class="h-px bg-white/10 my-2" aria-hidden="true" />

                  <!-- Email Contact -->
                  <a
                    href="mailto:madibaelvis@gmail.com"
                    class="flex justify-between glass py-3 px-4 rounded-xl hover:bg-white/5 transition-colors"
                    aria-label="Send email to madibaelvis@gmail.com"
                  >
                    <div class="flex gap-x-3 items-center text-center text-[#efefe5]">
                      <p class="underline decoration-dotted">
                        madibaelvis@gmail.com
                      </p>
                    </div>
                    <div class="text-[#a6a6a2] text-center items-center">
                      <Icon name="mail_line" class="text-xl" aria-hidden="true" />
                    </div>
                  </a>
                </div>
              </div>
            </div>

            <!-- Overlay -->
            <div
              id="overlay"
              class="fixed inset-0 bg-gray-900/40 backdrop-blur-lg backdrop-filter pointer-events-none transition-all duration-300 ease-in-out z-2000 opacity-0"
              style="-webkit-backdrop-filter: blur(15px);"
              aria-hidden="true"
            />
          </>
        )
      }
    </div>
  </nav>
</div>

<script>
  // Mobile bottom sheet functionality
  class NavigationManager {
    constructor() {
      this.navToggle = document.getElementById("navToggle");
      this.bottomSheet = document.getElementById("bottomSheet");
      this.overlay = document.getElementById("overlay");
      this.isOpen = false;
      this.isDragging = false;
      this.startY = 0;
      this.currentY = 0;

      if (this.navToggle && this.bottomSheet && this.overlay) {
        this.init();
      }
    }

    init() {
      // Bind methods to maintain context
      this.openBottomSheet = this.openBottomSheet.bind(this);
      this.closeBottomSheet = this.closeBottomSheet.bind(this);
      this.handleEscape = this.handleEscape.bind(this);
      this.handleTouchStart = this.handleTouchStart.bind(this);
      this.handleTouchMove = this.handleTouchMove.bind(this);
      this.handleTouchEnd = this.handleTouchEnd.bind(this);

      // Add event listeners
      this.navToggle.addEventListener("click", this.openBottomSheet);
      this.overlay.addEventListener("click", this.closeBottomSheet);
      document.addEventListener("keydown", this.handleEscape);

      // Touch events for swipe to close
      this.bottomSheet.addEventListener("touchstart", this.handleTouchStart, { passive: true });
      this.bottomSheet.addEventListener("touchmove", this.handleTouchMove, { passive: false });
      this.bottomSheet.addEventListener("touchend", this.handleTouchEnd, { passive: true });
    }

    openBottomSheet(e) {
      e.preventDefault();
      e.stopPropagation();

      if (!this.isOpen) {
        this.bottomSheet.style.transform = "translateY(0)";
        this.overlay.classList.remove("opacity-0", "pointer-events-none");
        this.overlay.classList.add("opacity-50");
        this.navToggle.setAttribute("aria-expanded", "true");
        this.isOpen = true;

        // Focus management
        this.bottomSheet.focus();

        // Prevent body scroll
        document.body.style.overflow = "hidden";
      }
    }

    closeBottomSheet(e = null) {
      if (e && e.type === "click" && e.target !== this.overlay) {
        return;
      }

      if (this.isOpen) {
        this.bottomSheet.style.transform = "translateY(calc(100% + 20px))";
        this.overlay.classList.add("opacity-0", "pointer-events-none");
        this.overlay.classList.remove("opacity-50");
        this.navToggle.setAttribute("aria-expanded", "false");
        this.isOpen = false;

        // Restore body scroll
        document.body.style.overflow = "";

        // Return focus to toggle button
        this.navToggle.focus();
      }
    }

    handleEscape(e) {
      if (e.key === "Escape" && this.isOpen) {
        this.closeBottomSheet();
      }
    }

    handleTouchStart(e) {
      // Don't start dragging if touching a link or button
      if (e.target.tagName === "A" || e.target.tagName === "BUTTON" || e.target.closest("a, button")) {
        return;
      }

      this.startY = e.touches[0].clientY;
      this.isDragging = true;
    }

    handleTouchMove(e) {
      if (!this.isDragging) return;

      this.currentY = e.touches[0].clientY;
      const deltaY = this.currentY - this.startY;

      // Only allow dragging down
      if (deltaY > 0) {
        e.preventDefault();
        this.bottomSheet.style.transform = `translateY(${deltaY}px)`;
      }
    }

    handleTouchEnd() {
      if (!this.isDragging) return;

      // Close if dragged down more than 80px
      if (this.currentY - this.startY > 80) {
        this.closeBottomSheet();
      } else {
        // Snap back to open position
        this.bottomSheet.style.transform = "translateY(0)";
      }

      this.isDragging = false;
    }

    cleanup() {
      // Remove all event listeners
      this.navToggle?.removeEventListener("click", this.openBottomSheet);
      this.overlay?.removeEventListener("click", this.closeBottomSheet);
      document.removeEventListener("keydown", this.handleEscape);
      this.bottomSheet?.removeEventListener("touchstart", this.handleTouchStart);
      this.bottomSheet?.removeEventListener("touchmove", this.handleTouchMove);
      this.bottomSheet?.removeEventListener("touchend", this.handleTouchEnd);

      // Restore body scroll
      document.body.style.overflow = "";
    }
  }

  // Initialize navigation manager
  let navManager = null;

  function initNavigation() {
    // Cleanup existing instance
    if (navManager) {
      navManager.cleanup();
    }

    // Create new instance
    navManager = new NavigationManager();
  }

  // Initialize on first page load
  document.addEventListener("DOMContentLoaded", initNavigation);

  // Re-initialize after Astro page transitions
  document.addEventListener("astro:page-load", initNavigation);

  // Cleanup before page swap
  document.addEventListener("astro:before-swap", () => {
    if (navManager) {
      navManager.cleanup();
    }
  });
</script>

<style>
  .mobile-nav-glass {
    background: rgba(10, 9, 15, 0.8);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .mobile-nav-inner {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .bottom-sheet-glass {
    background: rgba(10, 9, 15, 0.92);
    backdrop-filter: blur(32px) saturate(180%);
    -webkit-backdrop-filter: blur(32px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: none;
    box-shadow:
      0 -8px 40px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  #bottomSheet {
    will-change: transform;
  }

  #overlay {
    will-change: opacity;
  }

  body.sheet-open {
    overflow: hidden;
  }
</style>
