---
const { text, id } = Astro.props;
const tooltipId = id || "tooltip";
---

<div class="relative group inline-block">
  <div id={`${tooltipId}-wrapper`} data-tooltip-id={tooltipId}>
    <slot />
  </div>

  <div
    id={`${tooltipId}`}
    class="tooltip fixed glass text-[#efefe5] text-xs font-medium px-3 py-1.5 rounded-lg
    opacity-0 pointer-events-none z-10000 shadow-lg"
  >
    <span class="relative z-10">{text}</span>
  </div>
</div>

<script>
  // Tooltip manager with improved animation
  class TooltipManager {
    constructor() {
      this.tooltips = new Map();
      this.init();
    }

    init() {
      const wrappers = document.querySelectorAll("[data-tooltip-id]");

      wrappers.forEach((wrapper) => {
        const tooltipId = wrapper.getAttribute("data-tooltip-id");
        const tooltip = document.getElementById(tooltipId!);
        if (!tooltip) return;

        const handleMouseEnter = () => {
          document.addEventListener("mousemove", updateTooltip);
          tooltip.style.opacity = "1";
          tooltip.style.transform = "translateY(0) scale(1)";
        };

        const handleMouseLeave = () => {
          document.removeEventListener("mousemove", updateTooltip);
          tooltip.style.opacity = "0";
          tooltip.style.transform = "translateY(4px) scale(0.95)";
        };

        const updateTooltip = (event: MouseEvent) => {
          const x = event.clientX;
          const y = event.clientY;

          // Keep tooltip within viewport
          const tooltipRect = tooltip.getBoundingClientRect();
          const viewportWidth = window.innerWidth;
          const viewportHeight = window.innerHeight;

          let left = x + 2;
          let top = y - tooltipRect.height - 6;

          // Adjust if tooltip would go off right edge
          if (left + tooltipRect.width > viewportWidth - 10) {
            left = x - tooltipRect.width - 2;
          }

          // Adjust if tooltip would go off top edge - show below cursor instead
          if (top < 10) {
            top = y + 6;
          }

          // Adjust if tooltip would go off left edge
          if (left < 10) {
            left = 10;
          }

          tooltip.style.left = left + "px";
          tooltip.style.top = top + "px";
        };

        wrapper.addEventListener("mouseenter", handleMouseEnter);
        wrapper.addEventListener("mouseleave", handleMouseLeave);

        this.tooltips.set(tooltipId, {
          wrapper,
          tooltip,
          handleMouseEnter,
          handleMouseLeave,
          updateTooltip,
        });
      });
    }

    cleanup() {
      this.tooltips.forEach(
        ({ wrapper, handleMouseEnter, handleMouseLeave, updateTooltip }) => {
          wrapper.removeEventListener("mouseenter", handleMouseEnter);
          wrapper.removeEventListener("mouseleave", handleMouseLeave);
          document.removeEventListener("mousemove", updateTooltip);
        },
      );
      this.tooltips.clear();
    }
  }

  let tooltipManager: TooltipManager | null = null;

  function initTooltips() {
    if (tooltipManager) {
      tooltipManager.cleanup();
    }
    tooltipManager = new TooltipManager();
  }

  document.addEventListener("DOMContentLoaded", initTooltips);
  document.addEventListener("astro:page-load", initTooltips);
  document.addEventListener("astro:before-swap", () => {
    if (tooltipManager) {
      tooltipManager.cleanup();
    }
  });
</script>

<style>
  .tooltip {
    will-change: transform, opacity;
    transition:
      opacity 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      transform 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform: translateY(4px) scale(0.95);
    background: rgba(10, 9, 15, 0.85);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }
</style>
