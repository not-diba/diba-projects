---
import { Icon } from "astro-icon/components";
const { icon, hoverIcon } = Astro.props;
---

<ul
  class="nav-icon w-full sm:w-full h-fit px-6 py-3 rounded-xl glass flex items-center justify-center cursor-pointer relative group transition-all duration-300"
>
  <Icon
    name={icon}
    class="text-2xl transition-all duration-300 group-hover:opacity-0 group-hover:scale-75"
  />

  <Icon
    name={hoverIcon}
    class="text-2xl absolute opacity-0 scale-125 group-hover:opacity-100 group-hover:scale-100 transition-all duration-300 text-red-400"
  />
</ul>

<style>
  .nav-icon {
    will-change: transform, background-color;
  }

  .nav-icon:hover {
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.2);
  }

  .nav-icon:active {
    transform: scale(0.95);
  }
</style>
