---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
const { title, description, img, url, priority = false } = Astro.props;
---

<a
  class="border-[#232323] border bg-[#0a090f]
         flex gap-3 h-18 lg:w-87.5 md:w-87.5 w-full
         rounded-full p-1.5 cursor-pointer
         justify-between items-center
         transition-transform duration-300 ease-out
         hover:scale-110
         odd:hover:-skew-2 even:hover:skew-2
         group"
  href={url}
  title={title}
>
  <div class="flex gap-3 h-full">
    <div class="w-14 h-full rounded-full overflow-hidden bg-[#232323] shrink-0">
      <Image
        src={img}
        alt={title}
        width={56}
        height={64}
        format="avif"
        quality={80}
        loading={priority ? "eager" : "lazy"}
        decoding="async"
        class="w-full h-full object-cover rounded-full"
      />
    </div>

    <div class="flex flex-col w-44 min-w-0">
      <p class="text-lg font-medium text-red-500 truncate">
        {title}
      </p>
      <p class="text-base truncate">
        {description}
      </p>
    </div>
  </div>

  <div
    class="bg-[#191919] border-[1.2px] border-[#232323]
           w-14 h-14 rounded-full
           flex items-center justify-center
           transition-transform duration-300 ease-out
           odd:group-hover:-skew-2 even:group-hover:skew-2
           shrink-0"
  >
    <Icon name="arrow_right_line" class="size-6" aria-hidden="true" />
  </div>
</a>

<style>
  a {
    will-change: transform;
  }

  a > div:last-child {
    will-change: transform;
  }
</style>
